# Switch spaces with ctrl + 1-5
# disabled (yabai SA broken on macOS 27, using native Ctrl+N): ctrl - 1 : yabai -m space --focus 1
# disabled (yabai SA broken on macOS 27, using native Ctrl+N): ctrl - 2 : yabai -m space --focus 2
# disabled (yabai SA broken on macOS 27, using native Ctrl+N): ctrl - 3 : yabai -m space --focus 3
# disabled (yabai SA broken on macOS 27, using native Ctrl+N): ctrl - 4 : yabai -m space --focus 4
# disabled (yabai SA broken on macOS 27, using native Ctrl+N): ctrl - 5 : yabai -m space --focus 5

# Move windows to spaces (like Super+Shift+1-5)
cmd + shift - 1 : yabai -m window --space 1
cmd + shift - 2 : yabai -m window --space 2
cmd + shift - 3 : yabai -m window --space 3
cmd + shift - 4 : yabai -m window --space 4
cmd + shift - 5 : yabai -m window --space 5

# Move windows to spaces (like Super+Shift+1-5)
alt - 1 : /usr/bin/osascript -e 'tell application "System Events" to keystroke "b" using {control down}' && sleep 0.1 && /usr/bin/osascript -e 'tell application "System Events" to keystroke "q"' && sleep 0.1 && /usr/bin/osascript -e 'tell application "System Events" to keystroke "1"'

# Terminal shortcut (like Super+Return)
alt - c : open -a 'Webstorm'
alt - return : open -a 'Ghostty'
alt - b : open -a 'Google Chrome'
alt - m : open -a 'Spotify'

# focus windnow
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
alt - h : yabai -m window --focus west
alt - l : yabai -m window --focus east
